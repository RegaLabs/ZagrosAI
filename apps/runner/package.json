{
  "name": "@zagros/runner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "zagros-runner": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@zagros/acp": "workspace:*",
    "@zagros/protocol": "workspace:*",
    "@zagros/tools": "workspace:*",
    "playwright-core": "^1.62.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
