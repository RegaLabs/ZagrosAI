{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zagrosai",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "../web/dist", "binding": "ASSETS" },
  "d1_databases": [{ "binding": "DB", "database_name": "zagrosai", "database_id": "LOCAL" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "zagros-files" }],
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "exports": {
    "Hub": { "type": "durable-object", "storage": "sqlite" }
  },
  "workflows": [{ "name": "WORKFLOW", "class_name": "ScheduledTaskWorkflow", "binding": "WORKFLOW" }],
  "vars": { "VERSION": "1.0.0" },
  "observability": { "enabled": true }
}
